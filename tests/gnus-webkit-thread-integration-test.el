;;; gnus-webkit-thread-integration-test.el --- Shared reading slot -*- lexical-binding: t; -*-
(require 'ert)
(require 'gnus-thread-reader)
(require 'gnus-attachment-pane)
(require 'gnus-webkit-preview)

(defmacro gnus-webkit-thread-test--session (&rest body)
  "Use real thread navigation and MIME handles, stubbing transport and browser."
  (declare (indent 0))
  `(save-window-excursion
     (let* ((summary (generate-new-buffer " *thread-summary*"))
            (reader (generate-new-buffer " *thread-reader*"))
            (sources (list (gnus-webkit-test--fixture) (gnus-webkit-test--fixture)))
            (gnus-webkit-preview-created-functions nil)
            (gnus-webkit-preview-close-hook nil)
            (gnus-attachment-pane-mode nil)
            (headers (make-hash-table :test #'eql))
            selected previews window)
       (unwind-protect
           (progn
             (with-current-buffer summary
               (setq major-mode 'gnus-summary-mode)
               (setq-local gnus-newsgroup-name "nnimap+news-letter:INBOX"))
             (with-current-buffer reader
               (gnus-thread-reader-mode)
               (setq gnus-thread-reader--summary summary
                     gnus-thread-reader--group "nnimap+news-letter:INBOX")
               (dotimes (index 2)
                 (let* ((number (1+ index)) (id (number-to-string number))
                        (header (make-full-mail-header number "Title" "Author" ""
                                                       (format "<%d@test>" number) "" 0 0 "" nil)))
                   (puthash number header headers)
                   (with-current-buffer summary
                     (push (gnus-data-make number gnus-unread-mark nil header 1)
                           gnus-newsgroup-data))
                   (puthash id header gnus-thread-reader--headers)
                   (puthash id (with-current-buffer (nth index sources) (buffer-string))
                            gnus-thread-reader--raw-articles)
                   (puthash id '(html . "Body") gnus-thread-reader--bodies)
                   (puthash id (make-thread-reader-entry :id id) thread-reader--entries)))
               (let ((inhibit-read-only t))
                 (insert (propertize "From: root\nbody\n" 'thread-reader-id "1")
                         (propertize "* reply\nbody\n" 'thread-reader-id "2")))
               (goto-char (point-min)))
             (switch-to-buffer reader)
             (setq window (selected-window))
             (cl-letf (((symbol-function 'display-graphic-p) (lambda (&rest _) t))
                       ((symbol-function 'gnus-summary-goto-subject) (lambda (&rest _) t))
                       ((symbol-function 'gnus-summary-mark-article)
                        (lambda (number mark)
                          (push number selected)
                          (setf (gnus-data-mark (gnus-data-find number)) mark)))
                       ((symbol-function 'gnus-set-mode-line) (lambda (&rest _) nil))
                       ((symbol-function 'gnus-summary-select-article)
                        (lambda (_all _backward _force number)
                          (push number selected)
                          (setq-local gnus-article-buffer (nth (1- number) sources))
                          (with-current-buffer gnus-article-buffer
                            (setq-local gnus-article-current
                                        (cons "nnimap+news-letter:INBOX" number)))
                          (run-hooks 'gnus-select-article-hook)
                          ;; Native selection normally configures windows.
                          (set-window-buffer (split-window-below) gnus-article-buffer)))
                       ((symbol-function 'webkit-new)
                        (lambda (&rest _)
                          (let ((browser (generate-new-buffer " *thread-webkit*")))
                            (push browser previews)
                            (switch-to-buffer browser)
                            browser))))
               ,@body))
         (dolist (preview previews) (when (buffer-live-p preview) (kill-buffer preview)))
         (gnus-attachment-pane-close)
         (dolist (source sources)
           (mm-destroy-parts (buffer-local-value 'gnus-article-mime-handles source))
           (kill-buffer source))
         (kill-buffer reader)
         (kill-buffer summary)))))

(ert-deftest gnus-webkit-thread-navigation-and-quit-share-one-content-window ()
  (gnus-webkit-thread-test--session
    (let* ((preview (gnus-webkit-preview-open))
           (directory (buffer-local-value 'gnus-webkit-preview--directory preview)))
      (should (= (length (window-list)) 1))
      (should (eq (window-buffer window) preview))
      (should-not (get-buffer-window reader))
      (with-current-buffer preview (gnus-webkit-preview-next))
      (should-not (buffer-live-p preview))
      (should-not (file-exists-p directory))
      (should (= (length (window-list)) 1))
      (should (= (with-current-buffer reader (gnus-thread-reader--target)) 2))
      (with-current-buffer (window-buffer window) (gnus-webkit-preview-previous))
      (should (equal (reverse selected) '(1 2)))
      (with-current-buffer (window-buffer window) (gnus-webkit-preview-quit))
      (should (= (length (window-list)) 1))
      (should (eq (window-buffer window) reader))
      (should (= (with-current-buffer reader (gnus-thread-reader--target)) 1)))))

(ert-deftest gnus-webkit-thread-plain-text-returns-to-thread-without-extra-window ()
  (gnus-webkit-thread-test--session
    (let* ((preview (gnus-webkit-preview-open-thread))
           (plain (cadr sources)))
      (with-current-buffer plain
        (mm-destroy-parts gnus-article-mime-handles)
        (setq gnus-article-mime-handles nil))
      (with-current-buffer reader
        (puthash "2" "Content-Type: text/plain\n\nPlain body\n" gnus-thread-reader--raw-articles))
      (with-current-buffer preview (gnus-webkit-preview-next))
      (should-not (buffer-live-p preview))
      (should (= (length (window-list)) 1))
      (should (eq (window-buffer window) reader))
      (should (= (with-current-buffer reader (gnus-thread-reader--target)) 2)))))

(ert-deftest gnus-webkit-thread-failed-navigation-keeps-snapshot-and-reply-target ()
  (gnus-webkit-thread-test--session
    (let ((preview (gnus-webkit-preview-open-thread)))
      (cl-letf (((symbol-function 'webkit-new) (lambda (&rest _) (error "Renderer unavailable"))))
        (with-current-buffer preview (should-error (gnus-webkit-preview-next))))
      (should (buffer-live-p preview))
      (should (eq (window-buffer window) preview))
      (should (= (with-current-buffer reader (gnus-thread-reader--target)) 1))
      (should (= (length (window-list)) 1)))))

(ert-deftest gnus-webkit-thread-hidden-article-attachments-follow-preview ()
  (gnus-webkit-thread-test--session
    (let ((mime (generate-new-buffer " *thread-attachment*")))
      (unwind-protect
          (progn
            (with-current-buffer mime (insert "PDFDATA"))
            (with-current-buffer (car sources)
              (push (mm-make-handle mime '("application/pdf") nil nil
                                    '("attachment" (filename . "demo.pdf")))
                    gnus-article-mime-handles))
            (with-current-buffer reader
              (puthash "1" (string-replace "--outer--"
                                          "--outer\nContent-Type: application/pdf\nContent-Disposition: attachment; filename=demo.pdf\n\nPDFDATA\n--outer--"
                                          (gnus-thread-reader-raw-article "1"))
                       gnus-thread-reader--raw-articles))
            (let ((gnus-attachment-pane-mode t)
                  (gnus-webkit-preview-created-functions '(gnus-attachment-pane--adopt-preview))
                  (gnus-webkit-preview-close-hook '(gnus-attachment-pane--preview-closed)))
              (let* ((preview (gnus-webkit-preview-open-thread))
                     (pane (gnus-attachment-pane--window))
                     (snapshot (buffer-local-value 'gnus-attachment-pane--snapshot-directory
                                                   (window-buffer pane))))
                (should (= (length (window-list)) 2))
                (should (eq (window-buffer window) preview))
                (should-not (get-buffer-window reader))
                (should-not (get-buffer-window (car sources)))
                (should (file-exists-p (expand-file-name "demo.pdf" snapshot)))
                (with-current-buffer preview (gnus-webkit-preview-quit))
                (should-not (file-exists-p snapshot))
                (should (= (length (window-list)) 1))
                (should (eq (window-buffer window) reader)))))
        (when (buffer-live-p mime) (kill-buffer mime))))))

(ert-deftest gnus-webkit-thread-waits-for-raw-mime-without-native-network-selection ()
  (gnus-webkit-thread-test--session
    (with-current-buffer reader (remhash "1" gnus-thread-reader--raw-articles))
    (let (requested)
      (cl-letf (((symbol-function 'gnus-thread-reader-request-body) (lambda (id) (setq requested id)))
                ((symbol-function 'gnus-summary-select-article)
                 (lambda (&rest _) (ert-fail "Preview duplicated native network selection"))))
        (should-not (gnus-webkit-preview-open-thread))
        (should (equal requested "1"))
        (should (eq (window-buffer window) reader))
        (should (= (length (window-list)) 1))
        (with-current-buffer reader
          (puthash "1" (with-current-buffer (car sources) (buffer-string)) gnus-thread-reader--raw-articles)
          (run-hook-with-args 'gnus-thread-reader-article-loaded-functions "1"))
        (should (buffer-local-value 'gnus-webkit-preview-mode (window-buffer window)))
        (should (= (length (window-list)) 1))))))

(ert-deftest gnus-webkit-thread-late-mime-does-not-replace-a-new-thread-position ()
  (gnus-webkit-thread-test--session
    (with-current-buffer reader (remhash "1" gnus-thread-reader--raw-articles))
    (cl-letf (((symbol-function 'gnus-thread-reader-request-body) (lambda (&rest _) nil)))
      (gnus-webkit-preview-open-thread))
    (with-current-buffer reader
      (thread-reader-next)
      (puthash "1" (with-current-buffer (car sources) (buffer-string)) gnus-thread-reader--raw-articles)
      (run-hook-with-args 'gnus-thread-reader-article-loaded-functions "1")
      (should (equal (gnus-thread-reader-current-article-id) "2")))
    (should (eq (window-buffer window) reader))
    (should (= (length (window-list)) 1))))

(ert-deftest gnus-webkit-thread-cached-preview-survives-virtual-renumbering-and-read-filter ()
  (gnus-webkit-thread-test--session
    (with-current-buffer summary
      (setq gnus-newsgroup-name "nnvirtual:level2" gnus-newsgroup-data nil))
    (with-current-buffer reader
      (setq gnus-thread-reader--group "nnvirtual:level2")
      (maphash (lambda (id header)
                 (setf (mail-header-xref header)
                       (format "server nnimap+news-letter:INBOX:%d"
                               (+ 300 (string-to-number id)))))
               gnus-thread-reader--headers))
    (cl-letf (((symbol-function 'gnus-find-method-for-group)
               (lambda (&rest _) '(nnvirtual "test-server")))
              ((symbol-function 'nnvirtual-possibly-change-server) #'ignore)
              ((symbol-function 'nnvirtual-reverse-map-article)
               (lambda (_group number) (+ 100 (- number 300))))
              ((symbol-function 'nnvirtual-map-article)
               (lambda (number) (cons "nnimap+news-letter:INBOX" (+ 300 (- number 100)))))
              ((symbol-function 'gnus-thread-reader-request-body)
               (lambda (&rest _) (ert-fail "Lost cached MIME after re-numbering"))))
      (let ((preview (gnus-webkit-preview-open-thread)))
        (should (eq (window-buffer window) preview))
        (should (equal (with-current-buffer (buffer-local-value 'gnus-webkit-preview--source preview)
                         gnus-article-current)
                       '("nnimap+news-letter:INBOX" . 301)))
        (should (= (with-current-buffer reader (gnus-thread-reader--target)) 101))
        (with-current-buffer preview (gnus-webkit-preview-next))
        (should (= (with-current-buffer reader (gnus-thread-reader--target)) 102))
        (should-not selected)
        (should (= (length (window-list)) 1))
        (with-current-buffer (window-buffer window) (gnus-webkit-preview-quit))
        (should (eq (window-buffer window) reader))))))
