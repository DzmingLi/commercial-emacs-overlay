(ert-deftest commercial-gnus-cached-virtual-view-fills-and-preserves-reading ()
  ;; Exercise real startup, virtual mapping, header retrieval, in-place updates,
  ;; mark propagation and view restoration.  Only the RSS network boundary
  ;; and automatic scan scheduling are replaced; user state is isolated.
  (require 'nnrss)
  (let* ((directory (make-temp-file "gnus-view-test-" t))
         (before-buffers (buffer-list))
         (gnus-home-directory directory) (gnus-directory directory)
         (gnus-article-save-directory directory)
         (gnus-newsrc-file (expand-file-name ".newsrc.eld" directory))
         (gnus-startup-file (expand-file-name "gnus" directory))
         (gnus-init-file nil)
         (gnus-select-method '(nnnil ""))
         (gnus-select-methods '((nnnil "")))
         (gnus-agent nil) (gnus-use-cache nil) (gnus-use-dribble-file nil)
         (gnus-check-new-newsgroups nil) (gnus-check-bogus-newsgroups nil)
         (gnus-background-get-unread-articles t)
         (gnus-background-refresh-timer nil)
         (gnus-group-list-mode '(5 . t))
         (nnrss-directory directory)
         (gnus-use-scoring nil) (gnus-large-newsgroup nil)
         (gnus-summary-refresh--refresh-timer nil)
         (gnus-summary-refresh--refresh-pending nil)
         (gnus-summary-refresh--refresh-running nil)
         (headers '((1 "id1" "https://example.invalid/1" "First" "Author" "Mon, 12 Oct 2026 12:00:00 +0000")
                    (2 "id2" "https://example.invalid/2" "Second" "Author" "Mon, 12 Oct 2026 12:01:00 +0000"))))
    (unwind-protect
        (save-window-excursion
          (cl-letf (((symbol-function 'gnus-request-background-refresh) #'ignore)
                    ((symbol-function 'nnrss-check-group)
                     (lambda (&rest _) (ert-fail "Foreground RSS fetch")))
                    ((symbol-function 'gnus-summary-exit)
                     (lambda (&rest _) (ert-fail "Refresh exited the group")))
                    ((symbol-function 'gnus-request-set-mark)
                     (lambda (&rest _) (ert-fail "Refresh sent remote marks")))
                    ((symbol-function 'nnrss-possibly-change-group)
                     (lambda (&rest _)
                       (setq nnrss-group "feed" nnrss-group-min 1
                             nnrss-group-max (length headers)
                             nnrss-group-data headers))))
            (gnus-1)
            (with-current-buffer gnus-group-buffer
              (gnus-group-make-group "feed" '(nnrss ""))
              (gnus-group-make-group "aggregate" '(nnvirtual "\\`nnrss:feed\\'"))
              (gnus-group-list-groups)
              ;; No source cache yet: still open an empty Summary.
              (should (gnus-summary-read-group "nnvirtual:aggregate" nil t)))
            (let ((summary (get-buffer "*Summary nnvirtual:aggregate*")))
              (should (get-buffer-window summary))
              (with-current-buffer summary (should (zerop (buffer-size))))
              ;; Simulate publication of the first source scan.
              (gnus-set-active "nnrss:feed" '(1 . 2))
              (setcar (gnus-group-entry "nnrss:feed") 2)
              ;; Already-open aggregates must refresh past the large-group
              ;; threshold without reading from the minibuffer.
              (let ((gnus-large-newsgroup 1))
                (cl-letf (((symbol-function 'read-number)
                           (lambda (&rest _) (ert-fail "Background refresh prompted"))))
                  (gnus-summary-refresh--rebuild-visible))
                (should (= gnus-large-newsgroup 1)))
              (setq summary (get-buffer "*Summary nnvirtual:aggregate*"))
              (with-current-buffer summary
                (should (string-match-p "First" (buffer-string)))
                (should (string-match-p "Second" (buffer-string)))
                (should (equal (gnus-list-of-unread-articles "nnrss:feed") '(1 2)))
                ;; Keep a rendered article and the cursor on the second row.
                (goto-char (point-min)) (forward-line 1)
                (set-window-point (get-buffer-window summary) (point))
                (let ((article (get-buffer gnus-article-buffer)))
                  (should article)
                  (with-current-buffer article
                    (let ((inhibit-read-only t))
                      (erase-buffer) (insert "Rendered article"))
                    (setq gnus-article-mime-handles '(saved-mime)))
                  ;; Source state advances before the old virtual view exits.
                  (setq headers (append headers '((3 "id3" "https://example.invalid/3" "Third" "Author" "Mon, 12 Oct 2026 12:02:00 +0000"))))
                  (setf (gnus-info-marks (gnus-get-info "nnrss:feed")) '((tick 3)))
                  (gnus-set-active "nnrss:feed" '(1 . 3))
                  (setcar (gnus-group-entry "nnrss:feed") 3)
                  (cl-letf (((symbol-function 'mm-destroy-parts)
                             (lambda (&rest _) (ert-fail "Destroyed rendered MIME"))))
                    (gnus-summary-refresh--rebuild-visible))
                  (setq summary (get-buffer "*Summary nnvirtual:aggregate*"))
                  (set-buffer summary)
                  (with-current-buffer article
                    (should (equal (buffer-string) "Rendered article"))
                    (should (equal gnus-article-mime-handles '(saved-mime)))
                    (setq gnus-article-mime-handles nil)))
                (should (member 3 (cdr (assq 'tick (gnus-info-marks (gnus-get-info "nnrss:feed"))))))
                (should (string-match-p "Third" (buffer-string)))
                (should (equal (gnus-list-of-unread-articles "nnrss:feed") '(1 2 3)))
                (should (equal (car (assoc (nnvirtual-find-group-art
                                           "aggregate" (gnus-summary-article-number))
                                          (gnus-summary-refresh--view-rows)))
                               '("nnrss:feed" . 2)))
                ;; User filtering must continue to suppress automatic rebuilds.
                (push '(1) gnus-newsgroup-limits)
                (cl-letf (((symbol-function 'gnus-summary-refresh--rebuild-after-scan)
                           (lambda () (ert-fail "Overrode user filter"))))
                  (gnus-summary-refresh--rebuild-visible))))))
      (when gnus-summary-refresh--refresh-timer
        (cancel-timer gnus-summary-refresh--refresh-timer))
      (dolist (buffer (cl-set-difference (buffer-list) before-buffers))
        (when (buffer-live-p buffer)
          (let (kill-buffer-query-functions) (kill-buffer buffer))))
      (delete-directory directory t))))

(ert-deftest commercial-gnus-timeout-publishes-completion-and-cleans-worker ()
  (let ((gnus-background-get-unread-articles t)
        (gnus-thread-timeout-seconds 0.05)
        (gnus-select-method '(nnnil ""))
        (gnus-select-methods '((nnnil "")))
        (gnus-newsrc-alist '(dummy))
        (gnus-newsrc-hashtb (make-hash-table))
        (gnus-active-hashtb (make-hash-table))
        (gnus-group-list-mode '(2))
        (saved-hooks (default-value 'gnus-after-getting-new-news-hook))
        done process)
    (unwind-protect
        (progn
          (set-default 'gnus-after-getting-new-news-hook
                       (list (lambda () (setq done t))))
          (cl-letf (((symbol-function 'gnus-get-function) (lambda (&rest _) #'ignore))
                    ((symbol-function 'gnus-check-backend-function) #'ignore)
                    ((symbol-function 'gnus-method-denied-p) #'ignore)
                    ((symbol-function 'gnus-open-server) (lambda (&rest _) t))
                    ((symbol-function 'gnus-group-list-groups) #'ignore)
                    ((symbol-function 'gnus-read-active-for-groups)
                     (lambda (&rest _)
                       (setq process (make-process :name "scan-timeout-test"
                                                   :command '("sleep" "0.4") :noquery t))
                       (while (process-live-p process)
                         (accept-process-output process 0.02)))))
            (gnus-get-unread-articles 2)
            (let ((deadline (+ (float-time) 3)))
              (while (and (not done) (< (float-time) deadline))
                (accept-process-output nil 0.02)))
            (should done)
            (should-not (gnus-thread-group-running-p gnus-thread-group))
            (should-not (get-buffer " *gnus-get-unread-articles-nnnil-*"))))
      (set-default 'gnus-after-getting-new-news-hook saved-hooks)
      (when (and process (process-live-p process)) (delete-process process)))))
