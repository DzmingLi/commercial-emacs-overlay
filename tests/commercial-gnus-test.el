(ert-deftest commercial-gnus-smtp-transport-keeps-hook-and-server ()
  (require 'message)
  (require 'smtpmail)
  (let* ((hooks 0) received
        (message-send-mail-hook (list (lambda () (cl-incf hooks)))))
    (cl-letf (((symbol-function 'message-field-value) (lambda (_) "smtp example.invalid 465 alice"))
              ((symbol-function 'message-remove-header) #'ignore)
              ((symbol-function 'smtpmail-send-it)
               (lambda () (setq received (list smtpmail-smtp-server smtpmail-smtp-service smtpmail-smtp-user smtpmail-stream-type)))))
      (message-multi-smtp-send-mail)
      (should (= hooks 1))
      (should (equal received '("example.invalid" 465 "alice" tls))))))
