(ert-deftest commercial-gnus-modern-calendar-preserves-event-contract ()
  (require 'gnus-icalendar)
  (with-temp-buffer
    (insert "BEGIN:VCALENDAR\nVERSION:2.0\nPRODID:-//Test//EN\nMETHOD:REQUEST\nBEGIN:VEVENT\nUID:test\nDTSTART:20261004T120000Z\nDTEND:20261004T130000Z\nSUMMARY:Meet\\, discuss\nDESCRIPTION:First\\n\n second\nORGANIZER:mailto:host@example.invalid\nATTENDEE;CN=Alice;RSVP=TRUE:mailto:alice@example.invalid\nATTENDEE;CN=Bob;ROLE=OPT-PARTICIPANT:mailto:bob@example.invalid\nRRULE:FREQ=WEEKLY;INTERVAL=2;BYDAY=MO,WE\nEND:VEVENT\nEND:VCALENDAR\n")
    (let ((event (gnus-icalendar-event-from-buffer (current-buffer) '("alice@example.invalid"))))
      (should (equal (gnus-icalendar-event:summary event) "Meet, discuss"))
      (should (equal (gnus-icalendar-event:description event) "First\nsecond"))
      (should (equal (gnus-icalendar-event:req-participants event) '("Alice")))
      (should (equal (gnus-icalendar-event:opt-participants event) '("Bob")))
      (should (gnus-icalendar-event:rsvp event))
      (should (eq (gnus-icalendar-event:participation-type event) 'required))
      (should (equal (gnus-icalendar-event:recurring-freq event) "WEEKLY"))
      (should (equal (gnus-icalendar-event:recurring-interval event) "2"))
      (should (equal (gnus-icalendar-event:recurring-days event) '(1 3)))
      (should (equal (format-time-string "%FT%TZ" (gnus-icalendar-event:start-time event) t) "2026-10-04T12:00:00Z")))))

