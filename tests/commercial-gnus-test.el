(ert-deftest commercial-gnus-startup-cache-survives-newsrc-and-restores-counts ()
  (let* ((gnus-newsrc-alist
          (list (gnus-info-make "nnrss:cached" 2 nil nil '(nnrss ""))
                (gnus-info-make "nnvirtual:cached" 2 nil nil '(nnvirtual "cached"))))
         (gnus-newsrc-hashtb nil) (gnus-group-list nil)
         (gnus-active-hashtb (make-hash-table :test #'equal))
         (gnus-group-startup-cache nil))
    (gnus-make-hashtable-from-newsrc-alist)
    (setcar (gnus-group-entry "nnrss:cached") 7)
    (setcar (gnus-group-entry "nnvirtual:cached") 7)
    (puthash "nnrss:cached" '(1 . 10) gnus-active-hashtb)
    (gnus-save-group-startup-cache)
    (let ((serialized (with-output-to-string
                        (gnus-gnus-to-quick-newsrc-format
                         t nil 'gnus-group-startup-cache))))
      (setq gnus-group-startup-cache nil
            gnus-newsrc-hashtb nil
            gnus-active-hashtb (make-hash-table :test #'equal))
      (with-temp-buffer
        (insert serialized)
        (eval-buffer))
      (gnus-make-hashtable-from-newsrc-alist)
      (should-not (car (gnus-group-entry "nnrss:cached")))
      (gnus-restore-group-startup-cache)
      (should (= (car (gnus-group-entry "nnrss:cached")) 7))
      (should (= (car (gnus-group-entry "nnvirtual:cached")) 7))
      (should (equal (gnus-active "nnrss:cached") '(1 . 10)))
      ;; A stale snapshot must not replace a newly published result.
      (setcar (gnus-group-entry "nnrss:cached") 9)
      (puthash "nnrss:cached" '(1 . 12) gnus-active-hashtb)
      (gnus-restore-group-startup-cache)
      (should (= (car (gnus-group-entry "nnrss:cached")) 9))
      (should (equal (gnus-active "nnrss:cached") '(1 . 12))))))

(ert-deftest commercial-gnus-startup-displays-before-refresh ()
  (dolist (mode '(background synchronous offline child))
    (let ((gnus-background-get-unread-articles (not (eq mode 'synchronous)))
          (gnus-select-method '(nnnil ""))
          (gnus-agent nil) (gnus-dbus-close-on-sleep nil)
          (gnus-use-dribble-file nil) events deferred)
      (cl-letf (((symbol-function 'gnus-alive-p) (lambda () nil))
                ((symbol-function 'gnus-clear-system) #'ignore)
                ((symbol-function 'gnus-splash) #'ignore)
                ((symbol-function 'gnus-run-hooks)
                 (lambda (hook) (when (eq hook 'gnus-started-hook)
                                  (push 'started events))))
                ((symbol-function 'nnheader-init-server-buffer) #'ignore)
                ((symbol-function 'gnus-read-init-file) #'ignore)
                ((symbol-function 'gnus-start-news-server) (lambda (&rest _) t))
                ((symbol-function 'gnus-dribble-read-file) #'ignore)
                ((symbol-function 'gnus-setup-news)
                 (lambda (_force _level _offline defer)
                   (setq deferred defer)
                   (unless defer (push 'refresh events))))
                ((symbol-function 'gnus-start-draft-setup) #'ignore)
                ((symbol-function 'gnus-group-list-groups)
                 (lambda (&rest _) (push 'list events)))
                ((symbol-function 'gnus-group-first-unread-group) #'ignore)
                ((symbol-function 'gnus-configure-windows)
                 (lambda (&rest _) (push 'display events)))
                ((symbol-function 'gnus-group-set-mode-line) #'ignore)
                ((symbol-function 'gnus-request-background-refresh)
                 (lambda (level) (should (= level 2)) (push 'scheduled events))))
        (gnus-1 2 (eq mode 'offline) (eq mode 'child))
        (if (eq mode 'background)
            (progn
              (should deferred)
              (should (equal (reverse events) '(list display started scheduled))))
          (should-not deferred)
          (should (equal (reverse events) '(refresh list display started))))))))

(ert-deftest commercial-gnus-refresh-requests-coalesce-and-expire-with-session ()
  (let ((gnus-background-get-unread-articles t)
        (gnus-background-refresh-timer nil)
        (gnus-newsrc-hashtb (make-hash-table)) callback (scheduled 0) called)
    (cl-letf (((symbol-function 'gnus-thread-group-running-p) #'ignore)
              ((symbol-function 'gnus-alive-p) (lambda () t))
              ((symbol-function 'run-at-time)
               (lambda (_delay _repeat function)
                 (cl-incf scheduled) (setq callback function) 'fake-timer))
              ((symbol-function 'gnus-get-unread-articles)
               (lambda (level) (setq called level))))
      (gnus-request-background-refresh 2)
      (gnus-request-background-refresh 2)
      (should (= scheduled 1))
      (funcall callback)
      (gnus-dispatch-drain)
      (should (= called 2))
      (should-not gnus-background-refresh-timer)
      (setq called nil)
      (gnus-request-background-refresh 2)
      (setq gnus-newsrc-hashtb (make-hash-table))
      (funcall callback)
      (gnus-dispatch-drain)
      (should-not called))))

