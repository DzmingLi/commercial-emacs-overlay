;;; nnimap-scan-test.el --- Retain complete IMAP scans -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(require 'nnimap)
(require 'gnus-start)

(defun commercial-gnus-test-imap-scan (qresync incremental)
  "Exercise EARLY/FINISH with real flag parsing and a reused connection."
  (let* ((process-buffer (generate-new-buffer " *imap-scan-fixture*"))
         (nntp-server-buffer (generate-new-buffer " *imap-scan-output*"))
         (process (make-pipe-process :name "imap-scan-fixture"
                                     :buffer process-buffer :noquery t))
         (gnus-active-hashtb (make-hash-table :test #'equal))
         (gnus-newsrc-hashtb (make-hash-table :test #'equal))
         (nnimap-current-infos nil)
         (info (gnus-info-make "nnimap+fixture:INBOX" 1 '(1)
                              (and incremental '((unexist 2)))
                              '(nnimap "fixture")))
         (nnimap-object (make-nnimap :initial-resync 0))
         (sequence 0) scan)
    (setf (gnus-info-params info)
          `((uidvalidity . "9") (permanent-flags %Seen %Flagged %*)
            ,@(when incremental '((active 1 . 3) (modseq . "10")))))
    (gnus-set-active (gnus-info-group info) '(1 . 3))
    (puthash (gnus-info-group info) (list 1 info) gnus-newsrc-hashtb)
    (unwind-protect
        (cl-letf (((symbol-function 'nnimap-process-buffer-key)
                   (lambda () (buffer-name process-buffer)))
                  ((symbol-function 'gnus-buffers) (lambda () (list process-buffer)))
                  ((symbol-function 'nnimap-change-group) (lambda (&rest _) t))
                  ((symbol-function 'nnimap-capability) (lambda (&rest _) qresync))
                  ((symbol-function 'nnimap-quirk) #'identity)
                  ((symbol-function 'nnimap-send-command)
                   (lambda (format-string &rest _)
                     (cl-incf sequence)
                     (goto-char (point-max))
                     (if (string-prefix-p "UID FETCH" format-string)
                         (insert "* 1 FETCH (UID 1 FLAGS (\\Seen))\r\n"
                                 "* 2 FETCH (UID 3 FLAGS ())\r\n")
                       (insert "* OK [UIDVALIDITY 9] valid\r\n"
                               "* OK [UIDNEXT 4] next\r\n"
                               "* OK [HIGHESTMODSEQ 11] modseq\r\n")
                       (when qresync
                         (insert "* 2 FETCH (UID 3 FLAGS ())\r\n")))
                     (insert (format "%d OK complete\r\n" sequence))
                     sequence))
                  ((symbol-function 'nnimap-wait-for-response)
                   (lambda (number &rest _)
                     (save-excursion
                       (goto-char (point-min))
                       (should (search-forward (format "%d OK " number) nil t)))
                     t)))
          ;; Responses are already present before FINISH enters its macro.
          (setq scan (nnimap-retrieve-group-data-early "fixture" (list info)))
          ;; A foreground request has permission to clear/reuse the buffer.
          (nnimap-with-process-buffer (insert "Unrelated article response\n"))
          (nnimap-finish-retrieve-group-infos "fixture" (list info) scan)
          (should-not (range-member-p 3 (gnus-info-read info)))
          (should-not (range-member-p 3 (cdr (assq 'unexist (gnus-info-marks info)))))
          (should (range-member-p 2 (cdr (assq 'unexist (gnus-info-marks info)))))
          (should (range-member-p 1 (gnus-info-read info)))
          (with-current-buffer nntp-server-buffer
            (should (string-match-p "\"INBOX\" 3 1 y" (buffer-string)))))
      (delete-process process)
      (kill-buffer process-buffer)
      (kill-buffer nntp-server-buffer))))

(ert-deftest commercial-gnus-imap-full-scan-survives-process-buffer-reuse ()
  (commercial-gnus-test-imap-scan nil nil))
(ert-deftest commercial-gnus-imap-incremental-scan-survives-process-buffer-reuse ()
  (commercial-gnus-test-imap-scan nil t))
(ert-deftest commercial-gnus-imap-qresync-survives-process-buffer-reuse ()
  (commercial-gnus-test-imap-scan t t))

(ert-deftest commercial-gnus-imap-actor-checks-every-store-response ()
  (let* ((process-buffer (generate-new-buffer " *imap-mark-fixture*"))
         (process (make-pipe-process :name "imap-mark-fixture" :buffer process-buffer :noquery t))
         (gnus-backend-worker-p t) (sequence 0) checked reject-first)
    (unwind-protect
        (cl-letf (((symbol-function 'nnimap-process-buffer-key) (lambda () (buffer-name process-buffer)))
                  ((symbol-function 'gnus-buffers) (lambda () (list process-buffer)))
                  ((symbol-function 'nnimap-change-group) (lambda (&rest _) t))
                  ((symbol-function 'nnimap-send-command) (lambda (&rest _) (cl-incf sequence)))
                  ((symbol-function 'nnimap-get-response)
                   (lambda (tag) (push tag checked)
                     (if (and reject-first (= tag 1)) '(("NO" "rejected")) '(("OK" "stored"))))))
          (should (nnimap-request-set-mark "INBOX" '(((1) del (read)) ((2) add (read))) "fixture"))
          (should (equal (reverse checked) '(1 2)))
          (setq sequence 0 checked nil reject-first t)
          (should-error (nnimap-request-set-mark "INBOX" '(((1) del (read)) ((2) add (read))) "fixture")))
      (delete-process process) (kill-buffer process-buffer))))
