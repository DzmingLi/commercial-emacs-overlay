;;; gnus-backend-state-test.el --- State ordering and identity tests -*- lexical-binding: t; -*-
(require 'ert)
(require 'gnus-backend-state)

(ert-deftest gnus-state-rebases-reads-without-losing-remote-changes ()
  ;; The server marked 4 read while the user read 2 and made 1 unread.
  (should (equal (gnus-backend-state--rebase-range '(1 4) '(1) '(2)) '(2 4))))

(ert-deftest gnus-state-native-mark-preserves-other-articles ()
  (let ((info (gnus-info-make "nnimap+test:INBOX" 2 '(1 3) '((tick 5)) '(nnimap "test"))))
    (gnus-backend-state--apply-mark info 2 gnus-read-mark)
    (should (equal (gnus-info-read info) '((1 . 3))))
    (gnus-backend-state--apply-mark info 1 gnus-unread-mark)
    (should (equal (gnus-info-read info) '((2 . 3))))
    (should (equal (cdr (assq 'tick (gnus-info-marks info))) '(5)))))

(ert-deftest gnus-state-late-scan-and-old-ack-cannot-undo-last-user-mark ()
  (let* ((method '(nnimap "test")) (group "nnimap+test:INBOX")
         (info (gnus-info-make group 2 nil nil method '((uidvalidity . "7"))))
         (gnus-use-cache nil)
         (gnus-newsrc-alist (list (gnus-info-make "dummy.group" 0 nil) info))
         (gnus-newsrc-hashtb (make-hash-table :test #'equal))
         (gnus-active-hashtb (make-hash-table :test #'equal))
         (gnus-backend-state--marks (make-hash-table :test #'equal))
         (gnus-backend-state--sequence 0)
         (base (copy-tree (list info))) callbacks)
    (puthash group (list 1 info) gnus-newsrc-hashtb)
    (gnus-set-active group '(1 . 1))
    (cl-letf (((symbol-function 'gnus-backend-request)
               (lambda (_method _op _data success _failure &rest _) (push success callbacks)))
              ((symbol-function 'nnimap-update-infos)
               (lambda (&rest _) (setf (gnus-info-read info) '(1))))
              ((symbol-function 'gnus-publish-unread-articles) #'ignore))
      (gnus-backend-note-mark group 1 gnus-read-mark)
      (gnus-backend-note-mark group 1 gnus-unread-mark)
      ;; Acknowledge the old write after the later local unread action.
      (funcall (cadr callbacks) t)
      (gnus-backend-state--commit method base (make-hash-table :test #'equal) '(:marks nil) 0)
      (should-not (gnus-info-read info))
      (funcall (car callbacks) t)
      (should-not (gnus-info-read info)))))

(ert-deftest gnus-state-new-epoch-does-not-inherit-old-local-marks ()
  (let* ((method '(nnimap "test")) (group "nnimap+test:INBOX")
         (info (gnus-info-make group 2 nil nil method '((uidvalidity . "7"))))
         (gnus-use-cache nil)
         (gnus-newsrc-alist (list (gnus-info-make "dummy.group" 0 nil) info))
         (gnus-newsrc-hashtb (make-hash-table :test #'equal))
         (gnus-active-hashtb (make-hash-table :test #'equal))
         (gnus-backend-state--marks (make-hash-table :test #'equal))
         (base (copy-tree (list info))))
    (puthash group (list 1 info) gnus-newsrc-hashtb)
    (gnus-set-active group '(1 . 1))
    (puthash (list gnus-newsrc-hashtb (cons group 1) "7") '(1 82 pending)
             gnus-backend-state--marks)
    (cl-letf (((symbol-function 'nnimap-update-infos)
               (lambda (&rest _) (setf (gnus-info-params info) '((uidvalidity . "8"))
                                       (gnus-info-read info) nil)))
              ((symbol-function 'gnus-publish-unread-articles) #'ignore))
      (gnus-backend-state--commit method base (make-hash-table :test #'equal) '(:marks nil) 0)
      (should-not (gnus-info-read info)))))
