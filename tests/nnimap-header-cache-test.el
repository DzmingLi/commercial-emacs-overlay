;;; nnimap-header-cache-test.el --- Nonblocking IMAP summaries -*- lexical-binding: t; -*-
(require 'ert)
(require 'nnimap)
(require 'gnus-summary-refresh)

(defun commercial-imap-cache-test--head (n)
  (format "211 %d Article retrieved.\nFrom: Author\nSubject: Mail %d\nDate: Tue, 13 Oct 2026 00:00:00 +0000\nMessage-ID: <%d@fixture>\n.\n" n n n))

(ert-deftest commercial-gnus-imap-header-snapshot-persists-and-invalidates-with-uidvalidity ()
  (let* ((directory (make-temp-file "imap-head-cache-" t))
         (nnimap-header-cache-directory directory)
         (nnimap--header-caches (make-hash-table :test #'equal))
         (gnus-newsrc-hashtb (make-hash-table :test #'equal))
         (info (gnus-info-make "nnimap+fixture:INBOX" 2 nil nil '(nnimap "fixture")))
         (nntp-server-buffer (generate-new-buffer " *header-cache-test*"))
         (gnus-read-cached t))
    (setf (gnus-info-params info) '((uidvalidity . "first")))
    (puthash (gnus-info-group info) (list 3 info) gnus-newsrc-hashtb)
    (unwind-protect
        (with-current-buffer nntp-server-buffer
          (insert (commercial-imap-cache-test--head 3))
          (nnimap--cache-headers "INBOX" "fixture")
          (let ((file (car (nnimap--header-cache "INBOX" "fixture"))))
            (should (= (logand (file-modes file) #o777) #o600)))
          (clrhash nnimap--header-caches)
          (cl-letf (((symbol-function 'nnimap-change-group)
                     (lambda (&rest _) (ert-fail "Foreground IMAP connection"))))
            (should (eq (nnimap-retrieve-headers '(1 3) "INBOX" "fixture") 'headers))
            (should (string-match-p "Mail 3" (buffer-string)))
            (should-not (string-match-p "Mail 1" (buffer-string)))
            (setf (gnus-info-params info) '((uidvalidity . "replacement")))
            (nnimap-retrieve-headers '(3) "INBOX" "fixture")
            (should (zerop (buffer-size)))))
      (kill-buffer nntp-server-buffer)
      (delete-directory directory t))))

(ert-deftest commercial-gnus-imap-prefetch-yields-and-preserves-scanner-output ()
  (let* ((directory (make-temp-file "imap-prefetch-" t))
         (source-table (make-hash-table :test #'equal))
         (active-table (make-hash-table :test #'equal))
         (caches (make-hash-table :test #'equal))
         (info (gnus-info-make "nnimap+fixture:INBOX" 2 nil '((unexist 2)) '(nnimap "fixture")))
         (gnus-newsrc-hashtb source-table) (gnus-active-hashtb active-table)
         (nnimap-header-cache-directory directory) (nnimap--header-caches caches)
         (output (generate-new-buffer " *scan-output-test*")) worker beats timer)
    (puthash (gnus-info-group info) (list 2 info) source-table)
    (gnus-set-active (gnus-info-group info) '(1 . 3))
    (with-current-buffer output (insert "Active file output"))
    (setq beats 0 timer (run-at-time 0.01 0.01 (lambda () (cl-incf beats))))
    (unwind-protect
        (cl-letf (((symbol-function 'nnimap-retrieve-headers)
                   (lambda (numbers group server &rest _)
                     (should (equal numbers '(1 3)))
                     (should-not (eq (current-thread) main-thread))
                     (let ((deadline (+ (float-time) 0.15)))
                       (while (< (float-time) deadline) (accept-process-output nil 0.01)))
                     (with-current-buffer nntp-server-buffer
                       (dolist (n numbers) (insert (commercial-imap-cache-test--head n)))
                       (nnimap--cache-headers group server)) 'headers)))
          (setq worker (make-thread
                        (lambda ()
                          (let ((gnus-newsrc-hashtb source-table) (gnus-active-hashtb active-table)
                                (nnimap-header-cache-directory directory) (nnimap--header-caches caches)
                                (gnus-background-get-unread-articles t) (nntp-server-buffer output))
                            (nnimap--prefetch-group-headers "fixture" (list info))))))
          (while (thread-live-p worker) (accept-process-output nil 0.01))
          (thread-join worker)
          (should (> beats 3))
          (with-current-buffer output (should (equal (buffer-string) "Active file output")))
          (should (gethash 3 (cdr (nnimap--header-cache "INBOX" "fixture")))))
      (cancel-timer timer)
      (kill-buffer output)
      (delete-directory directory t))))

(ert-deftest commercial-gnus-cached-imap-virtual-summary-misses-never-mark-messages-read ()
  (let* ((directory (make-temp-file "imap-summary-" t))
         (before (buffer-list))
         (gnus-home-directory directory) (gnus-directory directory)
         (gnus-newsrc-file (expand-file-name ".newsrc.eld" directory))
         (gnus-startup-file (expand-file-name "gnus" directory)) (gnus-init-file nil)
         (gnus-select-method '(nnnil "")) (gnus-select-methods '((nnnil "")))
         (gnus-agent nil) (gnus-use-cache nil) (gnus-use-dribble-file nil)
         (gnus-check-new-newsgroups nil) (gnus-check-bogus-newsgroups nil)
         (gnus-background-get-unread-articles t) (gnus-background-refresh-timer nil)
         (gnus-group-list-mode '(5 . t)) (gnus-use-scoring nil) (gnus-large-newsgroup nil)
         (gnus-summary-refresh--refresh-timer nil) (gnus-summary-refresh--refresh-pending nil)
         (nnimap-header-cache-directory directory) (nnimap--header-caches (make-hash-table :test #'equal))
         (check-server (symbol-function 'gnus-check-server)) rendering)
    (unwind-protect
        (save-window-excursion
          (cl-letf (((symbol-function 'gnus-request-background-refresh) #'ignore)
                    ((symbol-function 'nnimap-request-create-group) (lambda (&rest _) t))
                    ((symbol-function 'gnus-check-server)
                     (lambda (method &rest args)
                       (if (eq (car method) 'nnimap)
                           (if rendering (ert-fail "Cached rendering connected to IMAP") t)
                         (apply check-server method args)))))
            (gnus-1)
            (with-current-buffer gnus-group-buffer
              (gnus-group-make-group "INBOX" '(nnimap "fixture"))
              (gnus-group-make-group "aggregate" '(nnvirtual "\\`nnimap\\+fixture:INBOX\\'"))
              (gnus-set-active "nnimap+fixture:INBOX" '(1 . 3))
              (setcar (gnus-group-entry "nnimap+fixture:INBOX") 3)
              (gnus-group-list-groups)
              (setq rendering t)
              (should (gnus-summary-read-group "nnimap+fixture:INBOX" nil t))
              (should (equal (gnus-list-of-unread-articles "nnimap+fixture:INBOX") '(1 2 3)))
              (should (gnus-summary-read-group "nnvirtual:aggregate" nil t)))
            (should (equal (gnus-list-of-unread-articles "nnimap+fixture:INBOX") '(1 2 3)))
            (switch-to-buffer "*Summary nnvirtual:aggregate*")
            (with-temp-buffer
              (insert (commercial-imap-cache-test--head 3))
              (nnimap--cache-headers "INBOX" "fixture"))
            (gnus-summary-refresh--rebuild-visible)
            (with-current-buffer "*Summary nnvirtual:aggregate*"
              (should (string-match-p "Mail 3" (buffer-string))))
            (should (equal (gnus-list-of-unread-articles "nnimap+fixture:INBOX") '(1 2 3)))
            (should-not (cdr (assq 'unexist (gnus-info-marks (gnus-get-info "nnimap+fixture:INBOX")))))))
      (dolist (b (buffer-list)) (unless (memq b before) (kill-buffer b)))
      (when (timerp gnus-summary-refresh--refresh-timer) (cancel-timer gnus-summary-refresh--refresh-timer))
      (delete-directory directory t))))

(ert-deftest commercial-gnus-imap-caches-real-transformed-fetch-response ()
  (let* ((directory (make-temp-file "imap-wire-head-" t))
         (nnimap-header-cache-directory directory)
         (nnimap--header-caches (make-hash-table :test #'equal))
         (gnus-newsrc-hashtb (make-hash-table :test #'equal))
         (head "From: Author\r\nSubject: Actual FETCH\r\nMessage-ID: <wire@fixture>\r\n\r\n"))
    (unwind-protect
        (with-temp-buffer
          (insert (format "* 1 FETCH (UID 9 RFC822.SIZE 200 BODY[HEADER.FIELDS (FROM SUBJECT MESSAGE-ID)] {%d}\r\n%s)\r\n21 OK complete\r\n"
                          (length head) head))
          (nnimap-transform-headers)
          (nnheader-remove-cr-followed-by-lf)
          (nnimap--cache-headers "INBOX" "fixture")
          (should (string-match-p "Actual FETCH"
                                  (gethash 9 (cdr (nnimap--header-cache "INBOX" "fixture"))))))
      (delete-directory directory t))))
