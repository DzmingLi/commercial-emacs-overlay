--- a/src/keyboard.c
+++ b/src/keyboard.c
@@ -4910,4 +4910,12 @@
 timer_check (void)
 {
+  /* accept-process-output runs this on Lisp workers too.  Timers publish
+     GUI state and can initialize WebKit's main RunLoop; running one on a
+     worker permanently assigns that RunLoop to the wrong native thread.
+     Leave both timers and pending_funcalls untouched for the main loop.
+     Fatal cleanup must not re-enter the callbacks that just failed.  */
+  if (!main_thread_p (current_thread) || fatal_error_in_progress)
+    return invalid_timespec ();
+
   struct timespec nexttime;
   Lisp_Object timers, idle_timers;
--- a/src/pgtkterm.c
+++ b/src/pgtkterm.c
@@ -3949,4 +3949,10 @@
-      while (g_main_context_pending (context))
-	{
-	  g_main_context_dispatch (context);
-	}
+      /* WebKit sources can remain ready after dispatch.  Return to the
+         Lisp command loop even if the context never becomes empty.  */
+      gint64 deadline = g_get_monotonic_time () + 4000;
+      unsigned dispatches = 0;
+      while (dispatches++ < 64 && g_main_context_pending (context))
+        {
+          g_main_context_dispatch (context);
+          if (g_get_monotonic_time () >= deadline)
+            break;
+        }
--- a/src/xgselect.c
+++ b/src/xgselect.c
@@ -277,8 +277,17 @@
          block_input wrapper, because event handlers call
          unblock_input.  Event loop recursion was causing Bug#15801.  */
       block_input ();
-      while (g_main_context_pending (context))
-        g_main_context_dispatch (context);
+      /* As in pgtk_read_socket, a continuously ready WebKit source must
+         not starve Lisp timers and command input.  Keep pending events
+         in the context so the next main-loop turn can dispatch them.  */
+      gint64 deadline = g_get_monotonic_time () + 4000;
+      unsigned dispatches = 0;
+      while (dispatches++ < 64 && g_main_context_pending (context))
+        {
+          g_main_context_dispatch (context);
+          if (g_get_monotonic_time () >= deadline)
+            break;
+        }
       unblock_input ();
       errno = pselect_errno;
       release_select_lock ();
