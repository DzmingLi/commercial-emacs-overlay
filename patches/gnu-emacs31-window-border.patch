+/* Draw into the same Cairo backing surface as glyphs and dividers.
+   HEIGHT is the offset of the bottom border, not the outer height.  */
+static void
+pgtk_draw_rectangular_frame (struct frame *f, unsigned long color,
+                             int x, int y, int width, int height, int thickness)
+{
+  if (width <= 0 || height <= 0 || thickness <= 0)
+    return;
+  cairo_t *cr = pgtk_begin_cr_clip (f);
+  pgtk_set_cr_source_with_color (f, color, false);
+  cairo_rectangle (cr, x, y, width, thickness);
+  cairo_rectangle (cr, x, y + height, width, thickness);
+  cairo_rectangle (cr, x, y, thickness, height);
+  cairo_rectangle (cr, x + width - thickness, y, thickness, height);
+  cairo_fill (cr);
+  pgtk_end_cr_clip (f);
+}
+
+static void
+pgtk_clear_rectangular_frame (struct frame *f, int x, int y,
+                              int width, int height, int thickness)
+{
+  if (width <= 0 || height <= 0 || thickness <= 0)
+    return;
+  pgtk_clear_area (f, x, y, width, thickness);
+  pgtk_clear_area (f, x, y + height, width, thickness);
+  pgtk_clear_area (f, x, y, thickness, height);
+  pgtk_clear_area (f, x + width - thickness, y, thickness, height);
+}
